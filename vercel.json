{
  "rewrites": [
    { "source": "/api/mangadex/(.*)", "destination": "/api/mangadex.js" },
    { "source": "/api/covers/(.*)", "destination": "/api/covers.js" },
    { "source": "/manga/:id", "destination": "/api/meta.js", "missing": [{ "type": "query", "key": "redirected" }] },
    { "source": "/my-comic/:id", "destination": "/api/meta.js", "missing": [{ "type": "query", "key": "redirected" }] },
    { "source": "/chapter/:id", "destination": "/api/meta.js", "missing": [{ "type": "query", "key": "redirected" }] },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

